generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  super_admin
  admin
  staff
  supplier
  trial
}

enum PlanType {
  free
  starter
  growth
  pro
  custom
}

enum SubscriptionStatus {
  active
  cancelled
  past_due
  expired
  trialing
}

enum BillingCycle {
  monthly
  yearly
  manual
}

enum CatalogStatus {
  active
  archived
}

enum AddonAssignmentStatus {
  active
  cancelled
  expired
}

enum SubscriptionSource {
  tenant
  admin
  manual
  system
}

enum NotificationChannel {
  in_app
  email
  whatsapp
}

enum NotificationDeliveryStatus {
  pending
  sent
  failed
  skipped
}

enum BillingRequestType {
  plan_change
  addon_activation
  limit_increase
  subscription_extension
  custom_feature
  manual_adjustment
  enterprise_customization
}

enum BillingRequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum CustomizationClassification {
  rejected
  future_roadmap
  enterprise_only
  billable_customization
  global_feature_candidate
}

enum WorkspaceStatus {
  active
  suspended
  trial
}

enum StockMovementType {
  in
  out
  transfer
}

enum SyncStatus {
  pending
  syncing
  synced
  failed
  needs_review
}

model User {
  id             String             @id @default(cuid())
  name           String
  email          String             @unique
  passwordHash   String
  role           UserRole           @default(admin)
  sessionVersion Int                @default(0)
  avatar         String?
  disabledAt     DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  memberships    WorkspaceMember[]
  movements      StockMovement[]
  auditLogs      AuditLog[]
  syncOperations SyncOperation[]
  scheduledActivities ScheduledActivity[]
  assignedAddons  WorkspaceAddon[]     @relation("AddonAssignedBy")
  subscriptionEvents SubscriptionEvent[]
  notificationDeliveries NotificationDelivery[]
  requestedBillingRequests BillingRequest[] @relation("BillingRequestRequestedBy")
  reviewedBillingRequests BillingRequest[] @relation("BillingRequestReviewedBy")
  billingRequestHistories BillingRequestHistory[]
}

model Workspace {
  id             String             @id @default(cuid())
  name           String
  plan           PlanType           @default(free)
  status         WorkspaceStatus    @default(active)
  logo           String?
  trialEndsAt    DateTime?
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  members        WorkspaceMember[]
  subscriptions  Subscription[]
  entitlements   Entitlement[]
  workspaceAddons WorkspaceAddon[]
  subscriptionEvents SubscriptionEvent[]
  notificationDeliveries NotificationDelivery[]
  categories     Category[]
  products       Product[]
  warehouses     Warehouse[]
  inventoryItems InventoryItem[]
  movements      StockMovement[]
  suppliers      Supplier[]
  auditLogs      AuditLog[]
  syncOperations SyncOperation[]
  settings       SystemSetting[]
  scheduledActivities ScheduledActivity[]
  billingRequests BillingRequest[]
}

model WorkspaceMember {
  id          String    @id @default(cuid())
  userId      String
  workspaceId String
  role        UserRole  @default(admin)
  createdAt   DateTime  @default(now())
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model Subscription {
  id                 String             @id @default(cuid())
  workspaceId        String
  planPackageId      String?
  plan               PlanType
  status             SubscriptionStatus @default(active)
  billingCycle       BillingCycle       @default(monthly)
  amountSnapshot     Int                @default(0)
  source             SubscriptionSource @default(tenant)
  currentPeriodStart DateTime
  currentPeriodEnd   DateTime
  cancelAtPeriodEnd  Boolean            @default(false)
  graceEndsAt         DateTime?
  renewalReminderSentAt DateTime?
  expiredProcessedAt DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt
  workspace          Workspace          @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  planPackage        PlanPackage?       @relation(fields: [planPackageId], references: [id], onDelete: SetNull)
  events             SubscriptionEvent[]

  @@index([workspaceId, status])
  @@index([planPackageId])
}

model PlanPackage {
  id                   String        @id @default(cuid())
  code                 String        @unique
  name                 String
  description          String?
  status               CatalogStatus @default(active)
  monthlyPrice         Int           @default(0)
  yearlyPrice          Int?
  originalMonthlyPrice Int?
  trialDays            Int           @default(0)
  sortOrder            Int           @default(0)
  warehouseLimit       Int           @default(1)
  productLimit         Int           @default(100)
  userLimit            Int           @default(1)
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt
  features             PlanFeature[]
  subscriptions        Subscription[]
  currentBillingRequests BillingRequest[] @relation("BillingRequestCurrentPackage")
  requestedBillingRequests BillingRequest[] @relation("BillingRequestRequestedPackage")

  @@index([status, sortOrder])
}

model PlanFeature {
  id            String      @id @default(cuid())
  planPackageId String
  feature       String
  enabled       Boolean     @default(true)
  limit         Int?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  planPackage   PlanPackage @relation(fields: [planPackageId], references: [id], onDelete: Cascade)

  @@unique([planPackageId, feature])
  @@index([feature])
}

model Addon {
  id             String             @id @default(cuid())
  code           String             @unique
  name           String
  description    String?
  status         CatalogStatus      @default(active)
  monthlyPrice   Int                @default(0)
  yearlyPrice    Int?
  featureKey     String?
  limitKey       String?
  limitIncrement Int?
  sortOrder      Int                @default(0)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  assignments    WorkspaceAddon[]
  billingRequests BillingRequest[]

  @@index([status, sortOrder])
}

model WorkspaceAddon {
  id                 String                @id @default(cuid())
  workspaceId        String
  addonId            String
  status             AddonAssignmentStatus @default(active)
  billingCycle       BillingCycle          @default(manual)
  quantity           Int                   @default(1)
  amountSnapshot     Int                   @default(0)
  currentPeriodStart DateTime              @default(now())
  currentPeriodEnd   DateTime?
  cancelAtPeriodEnd  Boolean               @default(false)
  assignedById       String?
  createdAt          DateTime              @default(now())
  updatedAt          DateTime              @updatedAt
  workspace          Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  addon              Addon                 @relation(fields: [addonId], references: [id], onDelete: Cascade)
  assignedBy         User?                 @relation("AddonAssignedBy", fields: [assignedById], references: [id], onDelete: SetNull)
  events             SubscriptionEvent[]

  @@index([workspaceId, status])
  @@index([addonId, status])
}

model SubscriptionEvent {
  id                 String          @id @default(cuid())
  workspaceId        String
  subscriptionId     String?
  workspaceAddonId   String?
  userId             String?
  type               String
  metadata           Json?
  createdAt          DateTime        @default(now())
  workspace          Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  subscription       Subscription?   @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  workspaceAddon     WorkspaceAddon? @relation(fields: [workspaceAddonId], references: [id], onDelete: SetNull)
  user               User?           @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
  @@index([subscriptionId])
  @@index([workspaceAddonId])
  @@index([type])
}

model BillingRequest {
  id                      String                      @id @default(cuid())
  workspaceId             String
  requestedById           String?
  reviewedById            String?
  type                    BillingRequestType
  status                  BillingRequestStatus       @default(pending)
  currentPlanPackageId    String?
  requestedPlanPackageId  String?
  addonId                 String?
  billingCycle            BillingCycle               @default(monthly)
  quantity                Int                        @default(1)
  requestedLimitKey       String?
  requestedLimitValue     Int?
  currentAmount           Int                        @default(0)
  requestedAmount         Int                        @default(0)
  billingImpact           Int                        @default(0)
  requestedActivationDate DateTime?
  approvedActivationDate  DateTime?
  approvedAmount          Int?
  promotionalAmount       Int?
  temporaryAccessUntil    DateTime?
  title                   String
  notes                   String?
  adminNotes              String?
  rejectionReason         String?
  classification          CustomizationClassification?
  metadata                Json?
  decidedAt               DateTime?
  createdAt               DateTime                   @default(now())
  updatedAt               DateTime                   @updatedAt
  workspace               Workspace                  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  requestedBy             User?                      @relation("BillingRequestRequestedBy", fields: [requestedById], references: [id], onDelete: SetNull)
  reviewedBy              User?                      @relation("BillingRequestReviewedBy", fields: [reviewedById], references: [id], onDelete: SetNull)
  currentPlanPackage      PlanPackage?               @relation("BillingRequestCurrentPackage", fields: [currentPlanPackageId], references: [id], onDelete: SetNull)
  requestedPlanPackage    PlanPackage?               @relation("BillingRequestRequestedPackage", fields: [requestedPlanPackageId], references: [id], onDelete: SetNull)
  addon                   Addon?                     @relation(fields: [addonId], references: [id], onDelete: SetNull)
  history                 BillingRequestHistory[]

  @@index([workspaceId, status, createdAt])
  @@index([type, status, createdAt])
  @@index([requestedPlanPackageId])
  @@index([addonId])
}

model BillingRequestHistory {
  id               String                @id @default(cuid())
  billingRequestId String
  userId           String?
  action           String
  fromStatus       BillingRequestStatus?
  toStatus         BillingRequestStatus?
  notes            String?
  metadata         Json?
  createdAt        DateTime              @default(now())
  billingRequest   BillingRequest        @relation(fields: [billingRequestId], references: [id], onDelete: Cascade)
  user             User?                 @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([billingRequestId, createdAt])
  @@index([userId])
}

model NotificationDelivery {
  id          String                     @id @default(cuid())
  workspaceId String?
  userId      String?
  channel     NotificationChannel        @default(in_app)
  type        String
  status      NotificationDeliveryStatus @default(pending)
  scheduledAt DateTime                   @default(now())
  sentAt      DateTime?
  attempts    Int                        @default(0)
  payload     Json
  lastError   String?
  createdAt   DateTime                   @default(now())
  updatedAt   DateTime                   @updatedAt
  workspace   Workspace?                 @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?                      @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, status, scheduledAt])
  @@index([type, scheduledAt])
}

model Entitlement {
  id          String    @id @default(cuid())
  workspaceId String
  feature     String
  enabled     Boolean   @default(true)
  limit       Int?
  expiresAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, feature])
}

model Category {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  description String?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  products    Product[]

  @@unique([workspaceId, name])
  @@index([workspaceId, disabledAt])
}

model Product {
  id             String           @id @default(cuid())
  workspaceId    String
  sku            String
  name           String
  description    String?
  categoryId     String
  minStock       Int              @default(0)
  price          Int              @default(0)
  disabledAt     DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  workspace      Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  category       Category         @relation(fields: [categoryId], references: [id])
  inventoryItems InventoryItem[]
  movements      StockMovement[]

  @@unique([workspaceId, sku])
  @@index([workspaceId, categoryId])
}

model Warehouse {
  id                   String           @id @default(cuid())
  workspaceId          String
  name                 String
  address              String?
  isDefault            Boolean          @default(false)
  disabledAt           DateTime?
  createdAt            DateTime         @default(now())
  updatedAt            DateTime         @updatedAt
  workspace            Workspace        @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  inventoryItems       InventoryItem[]
  movements            StockMovement[]  @relation("MovementWarehouse")
  destinationMovements StockMovement[]  @relation("DestinationWarehouse")

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model InventoryItem {
  id          String    @id @default(cuid())
  workspaceId String
  productId   String
  warehouseId String
  quantity    Int       @default(0)
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product     Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse   Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  @@unique([productId, warehouseId])
  @@index([workspaceId, warehouseId])
}

model StockMovement {
  id            String            @id @default(cuid())
  workspaceId   String
  productId     String
  warehouseId   String
  toWarehouseId String?
  type          StockMovementType
  quantity      Int
  notes         String?
  userId        String
  createdAt     DateTime          @default(now())
  workspace     Workspace         @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  product       Product           @relation(fields: [productId], references: [id])
  warehouse     Warehouse         @relation("MovementWarehouse", fields: [warehouseId], references: [id])
  toWarehouse   Warehouse?        @relation("DestinationWarehouse", fields: [toWarehouseId], references: [id])
  user          User              @relation(fields: [userId], references: [id])

  @@index([workspaceId, createdAt])
  @@index([productId])
  @@index([warehouseId])
}

model Supplier {
  id            String    @id @default(cuid())
  workspaceId   String
  name          String
  contactPerson String?
  phone         String?
  email         String?
  address       String?
  notes         String?
  disabledAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  workspace     Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([workspaceId])
}

model AuditLog {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime  @default(now())
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([workspaceId, createdAt])
}

model SyncOperation {
  id            String     @id @default(cuid())
  workspaceId   String
  userId        String
  key           String
  operationType String
  status        SyncStatus @default(pending)
  payload       Json?
  response      Json?
  error         String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  workspace     Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user          User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
  @@index([workspaceId, status])
}

model ScheduledActivity {
  id          String    @id @default(cuid())
  workspaceId String
  title       String
  type        String
  status      String    @default("pending")
  description String?
  dueAt       DateTime?
  disabledAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  createdBy   User?     @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([workspaceId, status])
  @@index([workspaceId, dueAt])
}

model SystemSetting {
  id          String    @id @default(cuid())
  workspaceId String
  key         String
  value       String
  description String?
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, key])
}
